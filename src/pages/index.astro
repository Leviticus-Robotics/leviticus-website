---
import type { ImageMetadata } from "astro";
import { getImage, Picture } from "astro:assets";
import team from "../assets/team.jpeg";
import PhotoCarousel from "../components/PhotoCarousel.svelte";
import Actions from "../components/ui/Actions.astro";
import BandSection from "../components/ui/BandSection.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import DisplayHeading from "../components/ui/DisplayHeading.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import Grid from "../components/ui/Grid.astro";
import HeroSection from "../components/ui/HeroSection.astro";
import Lead from "../components/ui/Lead.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { robotPhotos } from "../data/robotPhotos";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../utils/paths";

const thumbnailSizes = "(max-width: 640px) 78vw, (max-width: 980px) 33vw, 20vw";
const robotImages = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/robot/*.{jpeg,jpg,png,gif}",
);
const optimizedRobotPhotos = await Promise.all(
	robotPhotos.map(async (photo) => {
		if (!robotImages[photo.image]) {
			throw new Error(
				`"${photo.image}" does not exist in glob: "src/assets/robot/*.{jpeg,jpg,png,gif}"`,
			);
		}

		const source = (await robotImages[photo.image]()).default;
		const thumbnailSmall = await getImage({ src: source, width: 320, format: "avif" });
		const thumbnailLarge = await getImage({
			src: source,
			width: source.width,
			format: "avif",
		});
		const full = await getImage({
			src: source,
			width: source.width,
			format: "webp",
		});

		return {
			...photo,
			image: full.src,
			thumbnail: thumbnailSmall.src,
			thumbnailSrcset: `${thumbnailSmall.src} 320w, ${thumbnailLarge.src} ${source.width}w`,
			thumbnailSizes,
		};
	}),
);
---

<BaseLayout
	title="Home"
	description="Our team strives to implement industry standards and develop team skills, while systematically documenting our progress and embodying Gracious Professionalism by competing at the highest level, helping others, and spreading STEM throughout our community."
>
	<HeroSection aria-labelledby="home-title">
		<div>
			<Eyebrow>FTC Team 36099</Eyebrow>
			<DisplayHeading id="home-title">Leviticus</DisplayHeading>
			<Lead>
				Our team strives to implement industry standards and develop team skills, while systematically documenting our progress and embodying Gracious Professionalism by competing at the highest level, helping others, and spreading STEM throughout our community.
			</Lead>
				<Actions>
					<ButtonLink href={sitePath("/meet-our-team/")}>Meet the team</ButtonLink>
					<ButtonLink href={sitePath("/sponsors/")}>
						Support Leviticus
					</ButtonLink>
					<ButtonLink href={sitePath("/contact/")}>Contact us</ButtonLink>
				</Actions>
		</div>
		<figure
			class="m-0 overflow-hidden rounded-lg border border-site-line bg-site-ink shadow-[0_20px_55px_color-mix(in_srgb,var(--color-brand-purple-strong)_15%,transparent)]"
		>
			<Picture
				class="h-auto w-full"
				src={team}
				alt="Members of FTC Team 36099 Leviticus posing together outdoors"
				formats={["avif", "webp"]}
				widths={[378, 556, 756, 1112]}
				sizes="(max-width: 840px) calc(100vw - 2rem), 44vw"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>
	</HeroSection>

	<BandSection aria-labelledby="what-is-ftc-title" class="py-14">
		<div class="mb-14">
			<SectionHeading id="what-is-ftc-title">What do we do?</SectionHeading>
			<p class="max-w-220 text-lg leading-relaxed text-site-muted">
				We are a high school robotics team competing in FTC, an international robotics competition organized by FIRST. Each member learns engineering and programming skills and applies them practically.  At the core of FTC is Gracious Professionalism, encouraging fierce competition while fostering mutual respect and kindness.  We not only hope to build the best robot possible but also inspire others through community outreach. Through aligning with FIRST's core values and engaging with the community, we hope not just to learn but to give back in return.
			</p>
		</div>
		<section aria-labelledby="robot-gallery-title">
			<div class="mb-4 flex items-end justify-between gap-6 max-[640px]:items-start">
				<SectionHeader class="mb-0">
					<!-- <Eyebrow>Robot photos</Eyebrow> -->
					<SectionHeading id="robot-gallery-title">Build gallery</SectionHeading>
					<Lead>The robot components we've designed.</Lead>
				</SectionHeader>
			</div>
			<PhotoCarousel
				photos={optimizedRobotPhotos}
				id="robot-gallery"
				label="Robot gallery"
				lightboxLabel="Robot detail"
				previousLabel="Previous robot photo"
				nextLabel="Next robot photo"
				showArrows={false}
				client:visible
			/>
		</section>
	</BandSection>
	<!-- <BandSection aria-labelledby="snapshot-title">
		<SectionHeader>
			<SectionHeading id="snapshot-title">Explore</SectionHeading>
		</SectionHeader>
		<Grid>
			<FeatureCard href={sitePath("/meet-our-team/")}>
				<h3 class="text-xl leading-tight">Meet Our Team</h3>
				<p>
					Meet students from FTC 7854 and 15385, teams with World Championship and
					Premiere Events experience.
				</p>
			</FeatureCard>
			<FeatureCard href={sitePath("/contact/")}>
				<h3 class="text-xl leading-tight">Contact</h3>
				<p>Email, phone, and social links for families, sponsors, and community partners.</p>
			</FeatureCard>
		</Grid>
	</BandSection> -->
</BaseLayout>
