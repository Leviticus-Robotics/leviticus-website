---
import { sponsors, tierData } from "../data/team";
import SponsorCard from "../components/SponsorCard.astro";
import SponsorTierCard from "../components/SponsorTierCard.astro";
import Actions from "../components/ui/Actions.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import Card from "../components/ui/Card.astro";
import DisplayHeading from "../components/ui/DisplayHeading.astro";
import Grid from "../components/ui/Grid.astro";
import Lead from "../components/ui/Lead.astro";
import PageShell from "../components/ui/PageShell.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Tier } from "../types/content";

const tierOrder = [Tier.Gold, Tier.Silver, Tier.Bronze];
const sponsorTiers = tierOrder
	.map((tier) => ({
		tier,
		data: tierData[tier],
		sponsors: sponsors.filter((sponsor) => sponsor.tier === tier),
	}))
	.filter(({ sponsors }) => sponsors.length > 0);
---

<BaseLayout
	title="Sponsors"
	description="See FTC team 36099 Leviticus sponsors and learn how to apply as a sponsor."
>
	<section aria-labelledby="sponsors-title">
		<PageShell>
			<SectionHeader>
				<DisplayHeading id="sponsors-title">Sponsors</DisplayHeading>
				<Lead>
					Our mission wouldn't be possible without the generous support of our sponsors.
				</Lead>
				<Actions>
					<ButtonLink href="https://docs.google.com/forms/d/e/1FAIpQLSeuJUMxnH5lCd4_8uXCmLIfoTVo3fTaCCV93saXGdi8oOH6Yg/viewform?usp=publish-editor" target="_blank" rel="noreferrer">
						Sponsor us!
					</ButtonLink>
					<ButtonLink href="https://hcb.hackclub.com/donations/start/leviticus-robotics" target="_blank" rel="noreferrer">
						Donate
					</ButtonLink>
				</Actions>
			</SectionHeader>
			<section class="mb-16" aria-labelledby="sponsorship-tiers-title">
				<h2 id="sponsorship-tiers-title" class="mb-6 font-sans text-3xl font-extrabold">
					Sponsorship tiers
				</h2>
				<Grid>
					{tierOrder.map((tier) => <SponsorTierCard tier={tierData[tier]} />)}
				</Grid>
			</section>
			{
				sponsorTiers.length > 0 ? (
					<div class="space-y-12">
						{sponsorTiers.map(({ tier, data, sponsors: tierSponsors }) => (
							<section aria-labelledby={`tier-${tier}`}>
								<h2
									id={`tier-${tier}`}
									class="font-sans text-3xl font-extrabold"
									style={`color: ${data.color}`}
								>
									{data.label}
								</h2>
								<hr class="mt-3 mb-6 border-0 border-t border-site-line" />
								<Grid>
									{tierSponsors.map((sponsor) => <SponsorCard sponsor={sponsor} />)}
								</Grid>
							</section>
						))}
					</div>
				) : (
					<Card>
						<h2 class="mb-3 text-2xl">Become an inaugural sponsor</h2>
						<p>
							We are building our first sponsor roster. Organizations can use the application
							above to start a conversation with the team.
						</p>
					</Card>
				)
			}
		</PageShell>
	</section>
</BaseLayout>