---
import { sponsors, tiers } from "../data/team";
import SponsorCard from "../components/SponsorCard.astro";
import Actions from "../components/ui/Actions.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import Card from "../components/ui/Card.astro";
import DisplayHeading from "../components/ui/DisplayHeading.astro";
import Grid from "../components/ui/Grid.astro";
import Lead from "../components/ui/Lead.astro";
import PageShell from "../components/ui/PageShell.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Sponsors"
	description="See FTC team 36099 Leviticus sponsors and learn how to apply as a sponsor."
>
	<section aria-labelledby="sponsors-title">
		<PageShell>
			<SectionHeader>
				<DisplayHeading id="sponsors-title">Sponsors</DisplayHeading>
				<Lead>
					Our mission wouldn't be possible without the generous support of our sponsors.
				</Lead>
				<Actions>
					<ButtonLink href="https://docs.google.com/forms/d/e/1FAIpQLSeuJUMxnH5lCd4_8uXCmLIfoTVo3fTaCCV93saXGdi8oOH6Yg/viewform?usp=publish-editor" target="_blank" rel="noreferrer">
						Sponsor us!
					</ButtonLink>
					<ButtonLink href="https://hcb.hackclub.com/donations/start/leviticus-robotics" target="_blank" rel="noreferrer">
						Donate
					</ButtonLink>
				</Actions>
			</SectionHeader>
			{
				sponsors.length > 0 ? (
					<Grid>
						{
							sponsors.map((sponsor) => <SponsorCard sponsor={sponsor} />)
						}
					</Grid>
				) : (
					<Card>
						<h2 class="mb-3 text-2xl">Become an inaugural sponsor</h2>
						<p>
							We are building our first sponsor roster. Organizations can use the application
							above to start a conversation with the team.
						</p>
					</Card>
				)
			}
			{
				tiers.map(tier => (
					<Card>
						<h2 class="mb-3 text-2xl">{tier.level}</h2>
						<p>{tier.desc}</p>
						<h3 class="mb-3 text-2xl"> Benefits </h3>
						<ul>
							{
								tier.benefits.map(x => (<li>{x}</li>))
							}
						</ul>
					</Card>
				))
			}
		</PageShell>
	</section>

</BaseLayout>
