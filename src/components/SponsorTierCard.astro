---
import type { TierData } from "../types/content";

interface Props {
	tier: TierData;
}

const { tier } = Astro.props;
---

<article
	class="flex min-h-32 flex-col rounded-lg border border-site-line/70 bg-site-surface-glass p-6"
>
	<h3 class="font-sans text-2xl font-extrabold" style={`color: ${tier.color}`}>
		{tier.label}
	</h3>
	<p class="mt-1 text-lg font-bold text-site-ink">${tier.price.toLocaleString()}</p>
	<p class="mt-4 text-site-muted">{tier.desc}</p>
	<ul class="mt-4 list-disc space-y-2 pl-5 text-site-ink">
		{tier.benefits.map((benefit) => <li>{benefit}</li>)}
	</ul>
</article>
